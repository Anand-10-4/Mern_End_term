{
  "info": {
    "name": "GoldenCrust Bakery API Collection",
    "description": "Complete REST API collection for GoldenCrust Artisan Bakery & Custom Cake Studio",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5001/api/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "Auth - Login Customer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"customer@goldencrust.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "http://localhost:5001/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "Products - Get All Daily Bakes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5001/api/products?category=croissants_pastries",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "products"],
          "query": [{ "key": "category", "value": "croissants_pastries" }]
        }
      }
    },
    {
      "name": "Custom Cake - Dynamic Price Calculation",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"size\": \"standard_6inch\",\n  \"sponge\": \"belgian_chocolate\",\n  \"frosting\": \"salted_caramel\",\n  \"dietary\": \"eggless\",\n  \"customMessage\": \"Happy Birthday Sarah!\"\n}"
        },
        "url": {
          "raw": "http://localhost:5001/api/custom-cakes/calculate",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "custom-cakes", "calculate"]
        }
      }
    },
    {
      "name": "Orders - Place Order with Coupon & Loyalty Points",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{TOKEN}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"name\": \"Classic French Butter Croissant\",\n      \"price\": 4.5,\n      \"quantity\": 2\n    }\n  ],\n  \"fulfillmentType\": \"pickup\",\n  \"couponCode\": \"GOLDEN10\",\n  \"useLoyaltyPoints\": true\n}"
        },
        "url": {
          "raw": "http://localhost:5001/api/orders",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "orders"]
        }
      }
    },
    {
      "name": "Kitchen - Advance Order Pipeline",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{TOKEN}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"decorating\",\n  \"note\": \"Freshly pulled from deck oven, cooling on baker rack\"\n}"
        },
        "url": {
          "raw": "http://localhost:5001/api/orders/{{ORDER_ID}}/status",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "orders", "{{ORDER_ID}}", "status"]
        }
      }
    },
    {
      "name": "Analytics - Bakery Telemetry",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5001/api/analytics/dashboard",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "analytics", "dashboard"]
        }
      }
    }
  ]
}
